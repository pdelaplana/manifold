{
  "name": "manifold",
  "productName": "Manifold",
  "version": "0.1.0",
  "description": "Run and watch several Claude Code sessions side by side on Windows.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.patrick.manifold",
    "productName": "Manifold",
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
